{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure UVSC64Mock Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build/uvsc64",
                "-G",
                "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_CXX_COMPILER=g++"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:/Tools/msys64/ucrt64/bin;C:/Tools/msys64/usr/bin;${env:PATH}"
                },
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Debug Build UVSC64Mock.dll",
            "type": "shell",
            "command": "cmake",
            "dependsOn": "CMake: Configure UVSC64Mock Debug",
            "args": [
                "--build",
                "build/uvsc64",
                "--config",
                "Debug",
                "--parallel"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:/Tools/msys64/ucrt64/bin;C:/Tools/msys64/usr/bin;${env:PATH}"
                },
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "CMake: Clean UVSC64Mock Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/uvsc64",
                "--target",
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "problemMatcher": "$gcc"
        }
    ]
}